# ─────────────────────────────────────────────────────────────────────────
# .env.example — erwartete Umgebungsvariablen (NUR Namen, keine Werte).
# Lokal: als .env.local kopieren und ausfüllen. Prod: in Vercel setzen.
# ─────────────────────────────────────────────────────────────────────────

# ── HubSpot (Portal 146440145, EU) ──
# Private-App-Token (beginnt mit "pat-eu1-…"). Pflicht.
HUBSPOT_PRIVATE_APP_TOKEN=
# Optional: API-Basis überschreiben (Default https://api.hubapi.com)
HUBSPOT_API_BASE=
# Optional: Owner-ID für neue Leads (Default 81184186 = Teresa)
HUBSPOT_DEFAULT_OWNER_ID=

# ── SMTP (Transaktions-Mails via STRATO) ──
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ── Mail-Adressen ──
# Absender (Default = SMTP_USER, empfohlen termine@diebianco.de)
MAIL_FROM=
# Absender-Anzeigename (Default "DIE BIANCO")
MAIL_FROM_NAME=
# Team-Empfänger der Lead-Benachrichtigung, kommagetrennt
MAIL_TO=
# Reply-To der Kundenbestätigung (Default salon@diebianco.de)
MAIL_REPLYTO=
# ab-Preise in der Eingangsbestätigung anzeigen; "false" blendet sie aus (Default: an)
MAIL_PREISE_ANZEIGEN=

# ── Sonstiges ──
# Basis-URL für Links in Mails (Default https://www.diebianco.de)
SITE_URL=

# ── Cloudflare Turnstile (optional; nur aktiv, wenn beide gesetzt) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
